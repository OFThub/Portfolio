# EmailJS — contact form delivery.
# These three values are compiled into the public JS bundle; they are public by
# design. Protect the account by locking the service to your domain under
# EmailJS Dashboard → Account → Security → Allow-list.
# Leave them unset to run the site with the contact form disabled.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
